# systemd unit for the Vault Agent / Proxy on a Linux app server.
[Unit]
Description=Vault Proxy (local API proxy with auto-auth)
After=network-online.target
Wants=network-online.target

[Service]
User=vault-agent
Group=vault-agent
ExecStart=/usr/bin/vault proxy -config=/etc/vault-agent/agent-linux.hcl
RuntimeDirectory=vault-agent
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/vault-agent
LimitCORE=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
