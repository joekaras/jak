<Project Sdk="Microsoft.NET.Sdk">

  <!-- No PackageReferences by design: HttpClient and System.Text.Json ship with .NET 8. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Fis.Foundation.Vault</RootNamespace>
    <AssemblyName>Fis.Foundation.Vault</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Vault.Client.Tests" />
  </ItemGroup>

</Project>
