# systemd unit for the .NET Linux POC. Install to /etc/systemd/system/vault-poc.service.
# The deploy pipeline writes the wrapped secret_id to /run/vault-poc/wrapped-secret-id (mode 0400,
# owner vault-poc) right before `systemctl restart vault-poc`. The app deletes it after reading.
[Unit]
Description=Vault client POC (.NET)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=vault-poc
Group=vault-poc
WorkingDirectory=/opt/vault-poc
ExecStart=/opt/vault-poc/Poc.Linux
Environment=DOTNET_ENVIRONMENT=Production
RuntimeDirectory=vault-poc
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/vault-poc
# Keep secrets out of core dumps.
LimitCORE=0
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
