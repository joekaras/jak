<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ASP.NET Core comes from the shared framework; no NuGet packages. Host on IIS (in-process) or Kestrel. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Fis.Foundation.Vault.Poc.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Poc.Common\Poc.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="vault.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
